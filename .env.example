# Puerto HTTP donde el gateway enruta los endpoints de usuarios.
HTTP_PORT=3001

# Transporte TCP de microservicio (contrato users.validate) para otros servicios.
TCP_HOST=0.0.0.0
TCP_PORT=3011

# Base de datos propia de este servicio (independiente del monolito).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=users_service

# Secreto de servicio compartido: protege /internal/* (alta de perfil desde auth-service,
# hop B->C hacia auth-service). Debe coincidir con el de auth-service y bets-service.
INTERNAL_API_KEY=change-me-internal-key

# Hop B->C: auth-service para el estado de bloqueo dentro de users.validate.
AUTH_SERVICE_URL=http://localhost:8001

# --- Redis: consumer del stream security-events (auth-service) ---
REDIS_URI=redis://127.0.0.1:6379/0
REDIS_SECURITY_EVENTS_STREAM=security-events
# Nombre del consumer group propio de este servicio sobre el stream compartido.
REDIS_SECURITY_EVENTS_GROUP=users-service

# --- Observabilidad (Sentry) ---
# DSN del proyecto de Sentry. Vacío = SDK deshabilitado (no rompe el arranque local).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
